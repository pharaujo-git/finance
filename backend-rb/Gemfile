source "https://rubygems.org"

# API-only Rails. Active Record is deliberately absent: the schema is owned by
# the backend-neutral dbmate migrations in db/, so this app never issues DDL and
# talks to Postgres through the pg driver directly, as the other backends do.
gem "rails", "~> 8.1.3", ">= 8.1.3.1"
gem "puma", ">= 5.0"
gem "pg", "~> 1.5"
gem "jwt", "~> 2.9"

# Vercel's Ruby runtime serves through WEBrick; api/index.rb bridges it to Rack.
gem "webrick", "~> 1.9"

gem "tzinfo-data", platforms: %i[ windows jruby ]

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "rspec-rails", "~> 8.0"
  gem "rack-test", require: false
  gem "simplecov", require: false
  gem "simplecov_json_formatter", require: false
  gem "rubocop-rails-omakase", require: false
end
