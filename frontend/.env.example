# Base URLs of the Finance Tracker APIs (no trailing slash, no /api suffix).
# The backend is picked on the login page and stored under `ft.backend`.

# .NET API — falls back to VITE_API_URL, then http://localhost:5000
VITE_API_URL_DOTNET=http://localhost:5000

# Go API — falls back to http://localhost:8081
VITE_API_URL_GO=http://localhost:8081

# Python API — falls back to http://localhost:8082
VITE_API_URL_PYTHON=http://localhost:8082

# Node API — falls back to http://localhost:8083
VITE_API_URL_NODE=http://localhost:8083

# Rails API — falls back to http://localhost:8084
VITE_API_URL_RAILS=http://localhost:8084

# Legacy single-API variable, still honoured as the .NET fallback
VITE_API_URL=http://localhost:5000
